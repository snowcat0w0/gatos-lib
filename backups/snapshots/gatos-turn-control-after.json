{
  "module": "gatos-turn-control",
  "version": "0.3.0",
  "requires": [
    "gatos-lib"
  ],
  "settings": {
    "announceDelay": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GTC.Settings.AnnounceDelay.Name",
      "hint": "GTC.Settings.AnnounceDelay.Hint"
    },
    "autoEndPause": {
      "scope": "world",
      "config": true,
      "type": "Number",
      "default": 600,
      "name": "GTC.Settings.AutoEndPause.Name",
      "hint": "GTC.Settings.AutoEndPause.Hint",
      "range": {
        "min": 0,
        "max": 3000,
        "step": 100
      }
    },
    "autoEndTurn": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GTC.Settings.AutoEndTurn.Name",
      "hint": "GTC.Settings.AutoEndTurn.Hint"
    },
    "blockingConditions": {
      "scope": "world",
      "config": false,
      "type": "Object",
      "default": {},
      "onChange": true
    },
    "confusion": {
      "scope": "world",
      "config": false,
      "type": "Boolean",
      "default": true,
      "name": "GTC.Settings.Confusion.Name",
      "hint": "GTC.Settings.Confusion.Hint"
    },
    "excludeDefeated": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GTC.Settings.ExcludeDefeated.Name",
      "hint": "GTC.Settings.ExcludeDefeated.Hint",
      "onChange": true
    },
    "groupSwap": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GTC.Settings.GroupSwap.Name",
      "hint": "GTC.Settings.GroupSwap.Hint",
      "onChange": true
    },
    "hideDeadTokens": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GTC.Settings.HideDeadTokens.Name",
      "hint": "GTC.Settings.HideDeadTokens.Hint",
      "onChange": true
    },
    "hpDeath": {
      "scope": "world",
      "config": true,
      "type": "String",
      "default": "npc",
      "name": "GTC.Settings.HpDeath.Name",
      "hint": "GTC.Settings.HpDeath.HintGeneric",
      "choices": {
        "off": "GTC.Settings.HpDeath.Off",
        "npc": "GTC.Settings.HpDeath.Npc",
        "all": "GTC.Settings.HpDeath.All"
      },
      "onChange": true
    },
    "hpDeathAt": {
      "scope": "world",
      "config": true,
      "type": "Number",
      "default": 0,
      "name": "GTC.Settings.HpDeathAt.Name",
      "hint": "GTC.Settings.HpDeathAt.Hint",
      "onChange": true
    },
    "hpPath": {
      "scope": "world",
      "config": true,
      "type": "String",
      "default": "system.attributes.hp.value",
      "name": "GTC.Settings.HpPath.Name",
      "hint": "GTC.Settings.HpPath.Hint",
      "onChange": true
    },
    "hpStates": {
      "scope": "world",
      "config": false,
      "type": "Boolean",
      "default": true,
      "name": "GTC.Settings.HpStates.Name",
      "hint": "GTC.Settings.HpStates.Hint",
      "onChange": true
    },
    "revealOnCombatEnd": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GTC.Settings.RevealOnCombatEnd.Name",
      "hint": "GTC.Settings.RevealOnCombatEnd.Hint"
    }
  },
  "menus": {
    "blockingConditionsMenu": {
      "name": "GTC.Settings.BlockingMenu.Name",
      "label": "GTC.Settings.BlockingMenu.Label",
      "hint": "GTC.Settings.BlockingMenu.Hint",
      "icon": "fa-solid fa-face-dizzy",
      "restricted": true,
      "type": "BlockingConditionsConfig"
    }
  },
  "keybindings": {},
  "api": [
    "cancelDelay",
    "delay",
    "getBlockers",
    "getExclusion",
    "queueAfterCurrent",
    "resumeNow",
    "toggleNoTurn"
  ],
  "hooks": {
    "createActiveEffect": 2,
    "createCombatant": 1,
    "deleteActiveEffect": 2,
    "deleteCombat": 1,
    "getCombatTrackerContextOptions": 1,
    "init": 2,
    "ready": 2,
    "renderChatMessageHTML": 1,
    "renderCombatTracker": 1,
    "updateActiveEffect": 2,
    "updateActor": 2,
    "updateCombat": 1,
    "updateCombatant": 1,
    "updateToken": 1
  },
  "langPrefixes": [
    "GTC"
  ],
  "langUnresolved": [],
  "langDynamicPatterns": [
    "GTC.Condition.${id}",
    "GTC.Confusion.${r.key}",
    "GTC.Settings.${k}",
    "GTC.Tracker.Excluded.${reason}"
  ],
  "langDynamicUnmatched": [
    "GTC.Settings.${k}"
  ],
  "namespaceUnknown": []
}