    "absoluteUrl",
    "autoArchiveByCount",
    "buildBundle",
    "clearArchiveFile",
    "clearExportDirectory",
    "collectMessages",
    "deleteMessage",
    "deleteMessagesInRange",
    "diceDetails",
    "downloadArchiveJson",
    "duplicateMessage",
    "endSession",
    "exportJournal",
    "exportMarkdown",
    "exportSingleHtml",
    "exportText",
    "exportToDirectory",
    "exportZip",
    "getBookmarks",
    "getIndex",
    "getLockedSpeaker",
    "getSession",
    "htmlToText",
    "images",
    "importArchiveFile",
    "isChitchat",
    "isHighlighted",
    "loadArchive",
    "lookupPortrait",
    "markupToRuby",
