      "scope": "client",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.SpeakerFavorites.Name",
      "hint": "GCT.Settings.SpeakerFavorites.Hint",
      "onChange": true
    },
