      "name": "GCT.Settings.ImageUploadFolder.Name",
      "hint": "GCT.Settings.ImageUploadFolder.Hint"
    },
    "instantDelete": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.InstantDelete.Name",
      "hint": "GCT.Settings.InstantDelete.Hint"
    },
    "lastArchived": {
      "scope": "world",
      "config": false,
      "type": "Number",
      "default": 0
    },
    "lastExportMode": {
      "scope": "client",
      "config": false,
      "type": "String",
      "default": "html"
    },
    "playerEdit": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.PlayerEdit.Name",
      "hint": "GCT.Settings.PlayerEdit.Hint",
      "onChange": true
    },
    "portraitShape": {
      "scope": "client",
      "config": true,
      "type": "String",
      "default": "square",
      "name": "GCT.Settings.PortraitShape.Name",
      "choices": {
        "square": "GCT.Settings.PortraitShape.Square",
        "circle": "GCT.Settings.PortraitShape.Circle"
      },
      "onChange": true
    },
    "portraitSize": {
      "scope": "client",
      "config": true,
      "type": "Number",
      "default": 40,
      "name": "GCT.Settings.PortraitSize.Name",
      "hint": "GCT.Settings.PortraitSize.Hint",
      "range": {
        "min": 24,
        "max": 80,
        "step": 4
      },
      "onChange": true
    },
    "session": {
      "scope": "world",
      "config": false,
      "type": "Object",
      "default": {
        "active": false,
        "number": 0
      }
    },
    "sessionAnnounce": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.SessionAnnounce.Name",
      "hint": "GCT.Settings.SessionAnnounce.Hint"
