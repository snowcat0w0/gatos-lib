    "activateChatLog": 1,
    "canvasReady": 3,
    "canvasTearDown": 1,
    "chatMessage": 3,
    "clientSettingChanged": 1,
    "collapseSidebar": 3,
    "controlToken": 2,
    "createChatMessage": 3,
    "createSetting": 1,
    "deleteChatMessage": 2,
    "deleteToken": 2,
    "gctArchiveSaved": 1,
    "gctBookmarksChanged": 1,
    "gctSpeakerBarMounted": 1,
    "gctViewerActionsChanged": 1,
    "getChatMessageContextOptions": 3,
    "init": 4,
    "preCreateChatMessage": 5,
    "preUpdateChatMessage": 1,
    "ready": 3,
    "renderChatInput": 5,
    "renderChatLog": 6,
    "renderChatMessageHTML": 9,
    "targetToken": 1,
    "updateActor": 3,
    "updateChatMessage": 1,
    "updateSetting": 1,
    "updateToken": 3,
    "updateUser": 4
