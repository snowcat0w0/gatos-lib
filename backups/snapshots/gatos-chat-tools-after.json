    "showPortrait": {
      "scope": "client",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.ShowPortrait.Name",
      "hint": "GCT.Settings.ShowPortrait.Hint",
      "onChange": true
    },
    "speakerBar": {
      "scope": "client",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.SpeakerBar.Name",
      "hint": "GCT.Settings.SpeakerBar.Hint",
      "onChange": true
    },
