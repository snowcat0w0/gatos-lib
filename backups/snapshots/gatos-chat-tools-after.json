        "portrait": "GCT.Settings.FavoriteChipMode.Portrait",
        "name": "GCT.Settings.FavoriteChipMode.NameChoice"
      },
      "onChange": true
    },
    "groupChitchat": {
      "scope": "client",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.GroupChitchat.Name",
      "hint": "GCT.Settings.GroupChitchat.Hint",
      "onChange": true
    },
    "groupGapMinutes": {
      "scope": "client",
      "config": true,
      "type": "Number",
      "default": 0,
