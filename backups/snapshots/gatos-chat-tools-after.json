      "range": {
        "min": 0,
        "max": 120,
        "step": 5
      },
      "onChange": true
    },
    "groupMessages": {
      "scope": "client",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.GroupMessages.Name",
      "hint": "GCT.Settings.GroupMessages.Hint",
      "onChange": true
    },
    "hideSecret": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.HideSecret.Name",
      "hint": "GCT.Settings.HideSecret.Hint"
    },
    "imageAttach": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.ImageAttach.Name",
      "hint": "GCT.Settings.ImageAttach.Hint",
      "requiresReload": true
    },
    "imageUploadButton": {
      "scope": "client",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.ImageUploadButton.Name",
      "hint": "GCT.Settings.ImageUploadButton.Hint",
      "requiresReload": true
    },
