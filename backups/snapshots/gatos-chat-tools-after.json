{
  "module": "gatos-chat-tools",
  "version": "0.6.0",
  "requires": [
    "gatos-lib"
  ],
  "settings": {
    "archiveIndex": {
      "scope": "world",
      "config": false,
      "type": "Object",
      "default": {
        "list": []
      }
    },
    "autoArchiveKeep": {
      "scope": "world",
      "config": true,
      "type": "Number",
      "default": 50,
      "name": "GCT.Settings.AutoKeep.Name",
      "hint": "GCT.Settings.AutoKeep.Hint",
      "range": {
        "min": 0,
        "max": 1000,
        "step": 10
      }
    },
    "autoArchiveOnLoad": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": false,
      "name": "GCT.Settings.AutoOnLoad.Name",
      "hint": "GCT.Settings.AutoOnLoad.Hint"
    },
    "autoArchiveThreshold": {
      "scope": "world",
      "config": true,
      "type": "Number",
      "default": 0,
      "name": "GCT.Settings.AutoThreshold.Name",
      "hint": "GCT.Settings.AutoThreshold.Hint",
      "range": {
        "min": 0,
        "max": 5000,
        "step": 100
      }
    },
    "chatImagesCompat": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.ChatImagesCompat.Name",
      "hint": "GCT.Settings.ChatImagesCompat.Hint",
      "requiresReload": true
    },
    "chitchatAsOOC": {
      "scope": "world",
      "config": true,
      "type": "Boolean",
      "default": true,
      "name": "GCT.Settings.ChitchatAsOOC.Name",
      "hint": "GCT.Settings.ChitchatAsOOC.Hint"
    },
    "chitchatBrightness": {
      "scope": "client",
      "config": true,
      "type": "Number",
      "default": 0.7,
      "name": "GCT.Settings.ChitchatBrightness.Name",
      "hint": "GCT.Settings.ChitchatBrightness.Hint",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.05
      },
      "onChange": true
    },
    "chitchatFontSize": {
      "scope": "client",
      "config": true,
      "type": "Number",
      "default": 12,
      "name": "GCT.Settings.ChitchatFontSize.Name",
      "hint": "GCT.Settings.ChitchatFontSize.Hint",
      "range": {
        "min": 10,
        "max": 20,
        "step": 1
      },
      "onChange": true
    },
    "chitchatLineBreak": {
      "scope": "client",
      "config": true,
      "type": "Boolean",
      "default": false,
      "name": "GCT.Settings.ChitchatLineBreak.Name",
      "hint": "GCT.Settings.ChitchatLineBreak.Hint",
      "onChange": true
